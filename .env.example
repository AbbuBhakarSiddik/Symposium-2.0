# ---- NextAuth ----
# Generate with: openssl rand -base64 32  (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ---- Supabase (stores admin/coordinator logins, announcements, resources) ----
# Project Settings -> API in your Supabase dashboard.
# SUPABASE_SERVICE_ROLE_KEY is secret — server-only, never expose to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google Sheets (live registration counts) ----
# 1. Create a Google Cloud project -> enable the "Google Sheets API"
# 2. Create a Service Account -> generate a JSON key for it
# 3. Open your Google Sheet -> Share -> add the service account's
#    client_email as a Viewer
# 4. Copy the values below from the downloaded JSON key file
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Form Responses 1!A:Z
